zcomp_cpu-$(CONFIG_ZRAM_GS_BACKEND_ZSTD) += backend_zstd.o
zcomp_cpu-$(CONFIG_ZRAM_GS_BACKEND_DEFLATE) += backend_deflate.o
zcomp_cpu-$(CONFIG_ZRAM_GS_BACKEND_842) += backend_842.o

obj-$(CONFIG_ZRAM_GS)	+=	zram_gs.o
